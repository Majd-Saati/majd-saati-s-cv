# Public URL of the deployed site (no trailing slash).
# Enables the canonical URL, og:url, and sitemap.xml at build time.
VITE_SITE_URL=https://your-domain.com

# Sub-path the site is served from (e.g. /my-repo/ for a GitHub Pages project site).
# Leave empty when serving from the domain root. Set automatically by the GitHub Pages workflow.
VITE_BASE_PATH=
